<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>lazytune dependency licenses</title>
<style>body{font:16px/1.6 system-ui,sans-serif;max-width:78ch;margin:48px auto;padding:0 24px}pre{white-space:pre-wrap;font:13px/1.5 ui-monospace,monospace}section{margin:48px 0}</style>
<h1>lazytune dependency licenses</h1>
<p>License texts and copyright notices for dependencies recorded in Cargo.lock.</p>
{{#each licenses}}
<section>
<h2>{{name}}</h2>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</html>
